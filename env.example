# .env.example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Chroma Cloud ─────────────────────────────────────────────────────
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_tenant_name_here
CHROMA_DATABASE=your_database_name_here

# ── Grok API ─────────────────────────────────────────────────────────
GROK_API_KEY=your_grok_api_key_here
GROK_API_BASE_URL=https://api.groq.com/openai/v1
GROK_MODEL=llama-3.3-70b-versatile

# Backward-compatible fallback names (optional)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional overrides (defaults shown) ──────────────────────────────
# MAX_UPLOAD_MB=50
# MAX_PDF_PAGES=100
# MAX_IMAGE_PX=4096
# MAX_AUDIO_SEC=600
# MAX_VIDEO_SEC=300
# MAX_FILES_PER_BATCH=5
# PDF_TEXT_THRESHOLD=50
# CHUNK_SIZE_TOKENS=300
# CHUNK_OVERLAP_TOKENS=50
# MIN_CHUNK_TOKENS=30
# KEYFRAME_INTERVAL_SEC=10
# MAX_KEYFRAMES=30
# MIN_OCR_CONFIDENCE=0.3
# MIN_TRANSCRIPT_WORDS=5
# LOG_LEVEL=INFO
